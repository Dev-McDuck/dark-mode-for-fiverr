{
  "manifest_version": 3,
  "name": "Dark Mode for Fiverr",
  "version": "1.2",
  "description": "Adjustable dark mode for Fiverr. Not affiliated with Fiverr. Built with Claude.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["*://*.fiverr.com/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
